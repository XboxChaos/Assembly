<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Assembly.MultiPlatform.Views.CEPackagingDialog"
        Title="Campaign Evolved Packaging"
        Width="760" Height="680" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBackgroundBrush}">

  <!--
    One window for both unpack and repack (CEPackagingDialogViewModel.Mode picks which set of
    input rows shows via IsUnpack/IsRepack) rather than two near-identical windows - see that
    class's own remarks.

    Spacing below goes through StackPanel.Spacing / Grid.ColumnSpacing / Grid.RowSpacing bound to
    Theme/MetroTypography.axaml's Space1-6 scale, not per-element Margin: those three are plain
    double properties, exactly like FontSize, so a StaticResource lookup into Space1-6 (also
    plain doubles) assigns straight across. Margin and Padding are Thickness, not double, and nei-
    ther of Avalonia's two ways of getting a value into one takes a plain-double resource: a
    literal Thickness string goes through a string-to-Thickness TypeConverter that never runs for
    a resource lookup, and a resource assigned directly is cast straight to the property's own
    type with no conversion step at all - confirmed the hard way, not assumed: an early draft that
    tried Margin="{StaticResource Space4}" threw InvalidCastException at XAML load. The two
    Margin/Padding values below that could not be reworked onto *Spacing (the outer Grid's own
    inset, one Border's content padding) are therefore plain literals equal to the scale's current
    numbers (Space4=16, Space1=4, Space2=8) - matching how every Margin/Padding in MainWindow.axaml
    is already written, not a new exception to it. They will not track a future rescale the way the
    StaticResource-bound ones do; nothing left in this file needing that has to fall back to one.
  -->

  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space3}" Margin="16">

    <!-- ================= header ================= -->
    <StackPanel Grid.Row="0">
      <TextBlock Text="Unpack Campaign Evolved Tags" Classes="h1" FontSize="{StaticResource FontSizeTitle}"
                 IsVisible="{Binding IsUnpack}" />
      <TextBlock Text="Repack Campaign Evolved Tags" Classes="h1" FontSize="{StaticResource FontSizeTitle}"
                 IsVisible="{Binding IsRepack}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="{StaticResource Space4}">

        <StackPanel IsVisible="{Binding IsUnpack}" Spacing="{StaticResource Space1}">
          <TextBlock Text="UNPACK" Classes="sectionHeader accent" FontSize="{StaticResource FontSizeLarge}" />
          <TextBlock Classes="label" TextWrapping="Wrap"
                     Text="Extracts every tag a mounted Campaign Evolved container set resolves to into a folder of .ubulk files, one per tag, named by its resolved path and group. Nothing is written back to the source." />
        </StackPanel>
        <StackPanel IsVisible="{Binding IsRepack}" Spacing="{StaticResource Space1}">
          <TextBlock Text="REPACK" Classes="sectionHeader accent" FontSize="{StaticResource FontSizeLarge}" />
          <TextBlock Classes="label" TextWrapping="Wrap"
                     Text="Copies a source container set to a new folder and substitutes any changed tag files found into their owning containers. The source is never modified; output always goes to a separate folder." />
        </StackPanel>

        <!-- ================= inputs ================= -->
        <StackPanel Spacing="{StaticResource Space2}">
          <TextBlock Text="SOURCE CONTAINER SET" Classes="sectionHeader" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space1}">
            <TextBox Grid.Column="0" Text="{Binding SourcePath}" PlaceholderText="A .utoc file, or the folder holding the container set" />
            <Button Grid.Column="1" Content="Browse..." Click="OnBrowseSourceClick" />
          </Grid>

          <StackPanel IsVisible="{Binding IsRepack}" Spacing="{StaticResource Space2}">
            <TextBlock Text="TAGS DIRECTORY (edited .ubulk files)" Classes="sectionHeader" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space1}">
              <TextBox Grid.Column="0" Text="{Binding TagsDirectory}" PlaceholderText="An unpack's tags/ folder, or your own folder of *.ubulk files" />
              <Button Grid.Column="1" Content="Browse..." Click="OnBrowseTagsDirectoryClick" />
            </Grid>
          </StackPanel>

          <TextBlock Text="OUTPUT" Classes="sectionHeader" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space1}">
            <TextBox Grid.Column="0" Text="{Binding OutputDirectory}" PlaceholderText="Where to write the result. Never the same folder as the source." />
            <Button Grid.Column="1" Content="Browse..." Click="OnBrowseOutputClick" />
          </Grid>

          <CheckBox IsVisible="{Binding IsUnpack}" IsChecked="{Binding IncludeRawChunks}"
                    Content="Also dump every chunk of every container (research/diffing) into containers/, not just the tag payloads" />
        </StackPanel>

        <!-- ================= preview ================= -->
        <StackPanel Spacing="{StaticResource Space2}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="PREVIEW" Classes="sectionHeader" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Preview" Click="OnPreviewClick" IsEnabled="{Binding !IsPreviewing}" />
          </Grid>

          <TextBlock Text="Computing preview..." Classes="label dim" IsVisible="{Binding IsPreviewing}" />
          <TextBlock Text="{Binding PreviewError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding HasPreviewError}" />

          <StackPanel IsVisible="{Binding HasPreview}" Spacing="{StaticResource Space2}">
            <TextBlock Text="{Binding PreviewSummary}" Classes="mono" TextWrapping="Wrap" />

            <TextBlock Text="{Binding BlockingReason}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                       IsVisible="{Binding !PreviewCanProceed}" FontFamily="{DynamicResource MetroFontSemiBold}" />

            <Border BorderBrush="{DynamicResource SidebarHeaderSeperatorBrush}" BorderThickness="1" MaxHeight="220"
                    Padding="4">
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding PreviewLines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" Classes="mono" FontSize="{StaticResource FontSizeMicro}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>

            <ItemsControl ItemsSource="{Binding PreviewWarnings}" IsVisible="{Binding PreviewWarnings.Count}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding StringFormat='warning: {0}'}" Classes="label" Foreground="{DynamicResource WarnBrush}"
                             TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>

        <!-- ================= progress ================= -->
        <StackPanel IsVisible="{Binding IsRunning}" Spacing="{StaticResource Space2}">
          <TextBlock Text="RUNNING" Classes="sectionHeader" />
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressFraction}"
                       IsIndeterminate="{Binding ProgressIsIndeterminate}"
                       Foreground="{DynamicResource ExtryzeAccentBrush}" Height="6" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding ProgressDetail}" Classes="mono" FontSize="{StaticResource FontSizeSmall}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Classes="label mono">
              <TextBlock.Text>
                <MultiBinding StringFormat="[{0}] {1}/{2}">
                  <Binding Path="ProgressStage" />
                  <Binding Path="ProgressCompleted" />
                  <Binding Path="ProgressTotal" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </Grid>
          <Button Content="Cancel" Click="OnCancelRunClick" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- ================= result ================= -->
        <StackPanel IsVisible="{Binding HasResult}" Spacing="{StaticResource Space2}">
          <TextBlock Text="RESULT" Classes="sectionHeader" />
          <TextBlock Text="{Binding ResultHeadline}" TextWrapping="Wrap" FontFamily="{DynamicResource MetroFontSemiBold}"
                     Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding ResultSuccess}" />
          <TextBlock Text="{Binding ResultHeadline}" TextWrapping="Wrap" FontFamily="{DynamicResource MetroFontSemiBold}"
                     Foreground="{DynamicResource ErrorBrush}" IsVisible="{Binding !ResultSuccess}" />

          <Border Background="{DynamicResource SuccessBrushMuted}" Padding="8"
                  IsVisible="{Binding ResultByteIdentical}">
            <TextBlock Text="Byte-identical to the source: every container in the output is exactly the same bytes as the one it was copied from. Nothing was rewritten because nothing changed."
                       TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}" />
          </Border>

          <ItemsControl ItemsSource="{Binding ResultLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Classes="mono" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding ResultWarnings}" IsVisible="{Binding ResultWarnings.Count}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StringFormat='warning: {0}'}" Classes="label" Foreground="{DynamicResource WarnBrush}"
                           TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- ================= footer ================= -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource Space2}">
      <TextBlock Grid.Column="0" Text="Repack always validates every tag file before writing anything; one bad file aborts the whole run."
                 Classes="label dim" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding IsRepack}" />
      <Button Grid.Column="1" Content="Close" Click="OnCloseClick" IsEnabled="{Binding !IsRunning}" />
      <Button Grid.Column="2" Content="Unpack" Classes="accent" Click="OnRunClick" IsEnabled="{Binding CanRun}" IsVisible="{Binding IsUnpack}" />
      <Button Grid.Column="2" Content="Repack" Classes="accent" Click="OnRunClick" IsEnabled="{Binding CanRun}" IsVisible="{Binding IsRepack}" />
    </Grid>
  </Grid>
</Window>
