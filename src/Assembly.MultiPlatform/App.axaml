<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Assembly.MultiPlatform.Views"
             x:Class="Assembly.MultiPlatform.App"
             RequestedThemeVariant="Default">

  <!--
    RequestedThemeVariant="Default" (rather than the previous hardcoded "Dark") means "follow
    Avalonia.Controls.PlatformSettings" - i.e. the OS light/dark setting - and both FluentTheme
    and MetroDark.axaml's <ResourceDictionary.ThemeDictionaries> resolve against whichever
    variant that turns out to be. MainWindow.axaml no longer overrides this per-window either -
    see its own comment for the residual gap that leaves (elements outside this pass's scope
    that use StaticResource instead of DynamicResource won't repaint on a *live* OS theme
    change, only re-resolve correctly at next launch).
  -->

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Assembly/Theme/MetroStyles.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Assembly/Theme/MetroDark.axaml" />
        <ResourceInclude Source="avares://Assembly/Theme/MetroTypography.axaml" />
        <ResourceInclude Source="avares://Assembly/Theme/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <views:OkBrushConverter x:Key="OkBrush" />
      <views:QuietOkBrushConverter x:Key="QuietOkBrush" />
      <views:FooterBrushConverter x:Key="FooterBrush" />
      <views:FooterForegroundBrushConverter x:Key="FooterForegroundBrush" />
      <views:HeaderSubtitleConverter x:Key="HeaderSubtitle" />
      <views:DepthRangeConverter x:Key="DepthRange" />
      <views:ExpanderGlyphConverter x:Key="ExpanderGlyph" />
      <views:DirtyBrushConverter x:Key="DirtyBrush" />
      <views:LogLevelBrushConverter x:Key="LogLevelBrush" />
      <views:LogLevelBackgroundBrushConverter x:Key="LogLevelBackgroundBrush" />
      <views:StripDirtyMarkerConverter x:Key="StripDirtyMarker" />
      <!-- TypeBadgeForeground is used only from within MetroStyles.axaml's own
           Setter Property="Converter=..." bindings, which can't resolve a Converter through this
           Application-level dictionary (see that file's header) - it is registered again there,
           in that file's own Styles.Resources, instead. -->
    </ResourceDictionary>
  </Application.Resources>

</Application>
