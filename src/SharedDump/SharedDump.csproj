<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <RootNamespace>SharedDump</RootNamespace>
    <AssemblyName>SharedDump</AssemblyName>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <!-- Properties\AssemblyInfo.cs is checked in and still owns the assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- Lets the net48 target framework compile on machines without the .NET Framework
         targeting packs installed (i.e. macOS/Linux via `dotnet build`). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Blamite\Blamite.csproj" />
  </ItemGroup>
</Project>
