<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Assembly.Avalonia.Views.PropertiesPanel"
             Focusable="True">
  <StackPanel Spacing="10">
    <!-- Document-scoped undo/redo, always visible (rather than scoped to whichever field is
         selected) since an edit's undo step can outlive the selection moving to a different row. -->
    <StackPanel Name="HistoryBar" Orientation="Horizontal" Spacing="6" IsVisible="False">
      <Button Name="UndoButton" Content="Undo" Padding="8,3" FontSize="11" ToolTip.Tip="Cmd+Z" />
      <Button Name="RedoButton" Content="Redo" Padding="8,3" FontSize="11" ToolTip.Tip="Cmd+Shift+Z" />
      <TextBlock Name="HistoryLabel" Classes="label dim" VerticalAlignment="Center" FontSize="10" />
    </StackPanel>
    <Border Height="1" Background="{StaticResource SidebarHeaderSeperatorBrush}" />

    <!-- Populated in code-behind per selected row/kind - see PropertiesPanel.Refresh(). -->
    <StackPanel Name="FieldHost" Spacing="10" />
  </StackPanel>
</UserControl>
