<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Assembly.Avalonia.ViewModels"
        xmlns:views="clr-namespace:Assembly.Avalonia.Views"
        x:Class="Assembly.Avalonia.Views.MainWindow"
        Title="{Binding WindowTitle}"
        Width="1400" Height="880"
        MinWidth="900" MinHeight="560"
        Background="{DynamicResource MainBackgroundBrush}">

  <!--
    Chrome decision: real Assembly is a borderless custom window (AllowsTransparency, custom
    resize thumbs, hand-drawn min/restore/maximize/close glyphs) with its own drop shadow.
    This shell deliberately keeps the native macOS window frame (real traffic lights, native
    resize/snap/Mission-Space/Spaces/VoiceOver support) instead of reproducing that borderless
    chrome: on macOS a custom-drawn titlebar actively fights window management and
    accessibility, and it is not what "VS Code ergonomics" actually means in practice - VS Code
    itself uses native chrome on macOS and only re-skins the *content* below it. Everything
    below the native titlebar - the branded header band, the toolbar, the tag tree, the tabs,
    the field table and the value/console panes - is a faithful port of Assembly's interior.

    Theme decision: this Window no longer pins RequestedThemeVariant="Dark" - it inherits
    Application's RequestedThemeVariant="Default" (see App.axaml), which follows the OS light/
    dark setting through Avalonia.Controls.PlatformSettings, and every brush below is a
    DynamicResource into Theme/MetroDark.axaml's <ResourceDictionary.ThemeDictionaries> so it
    repaints correctly for whichever variant that resolves to.
  -->

  <!--
    Every Gesture string below is a NativeMenuItem-XAML-only concern - Avalonia's KeyGestureConverter
    parses it with a literal "Cmd" token (Meta), not the platform-primary-modifier lookup
    Services/PlatformKeys.cs uses for the in-window global handler (MainWindow.axaml.cs's
    OnGlobalKeyDown), because a NativeMenu is macOS's own menu bar - it has no meaning on a
    platform that would otherwise want Ctrl here, so there is no cross-platform label to get right
    in the first place (see NativeMenu's own Avalonia docs: it only renders at all on macOS).
    Bracket/backslash/question-mark keys have to be spelled as their Key enum names
    (OemOpenBrackets, not "[") - the literal punctuation characters fail to parse (verified
    against Avalonia 12.1.1's KeyGestureConverter directly - "Cmd+[" throws, "Cmd+OemOpenBrackets"
    does not).
  -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="File">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Open Cache File..." Gesture="Cmd+O" Click="OnMenuOpenFile" />
            <NativeMenuItem Header="Open Folder..." Gesture="Cmd+Shift+O" Click="OnMenuOpenFolder" />
            <NativeMenuItem Header="Open Zip..." Click="OnMenuOpenZip" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Save" Gesture="Cmd+S" Click="OnMenuSave" />
            <NativeMenuItem Header="Revert All Changes" Click="OnMenuRevertAll" />
            <NativeMenuItemSeparator />
            <!-- Campaign Evolved's tags live in a folder of IoStore containers rather than one
                 cache file (see ce-packaging's own remarks in CEPackagingService.cs), so getting
                 them onto disk and back is its own workflow rather than another Open/Save pair. -->
            <NativeMenuItem Header="Unpack Campaign Evolved Tags..." Click="OnMenuUnpack" />
            <NativeMenuItem Header="Repack Campaign Evolved Tags..." Click="OnMenuRepack" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Close Tab" Gesture="Cmd+W" Click="OnMenuCloseTab" />
            <NativeMenuItem Header="Close All" Click="OnMenuCloseAll" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="View">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Command Palette..." Gesture="Cmd+K" Click="OnMenuCommandPalette" />
            <NativeMenuItem Header="Go to Tag..." Gesture="Cmd+P" Click="OnMenuGoToTag" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Focus Tag Filter" Gesture="Cmd+F" Click="OnMenuFocusSearch" />
            <NativeMenuItem Header="Focus Field Filter" Gesture="Cmd+Shift+F" Click="OnMenuFocusFieldFilter" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Toggle Tag Tree" Gesture="Cmd+OemBackslash" Click="OnMenuToggleTagTree" />
            <NativeMenuItem Header="Toggle Properties Sidebar" Gesture="Cmd+Shift+OemBackslash" Click="OnMenuToggleValueSidebar" />
            <NativeMenuItem Header="Toggle Console" Gesture="Cmd+Alt+OemBackslash" Click="OnMenuToggleConsole" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Go Back" Gesture="Cmd+OemOpenBrackets" Click="OnMenuGoBack" />
            <NativeMenuItem Header="Go Forward" Gesture="Cmd+OemCloseBrackets" Click="OnMenuGoForward" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Switch Theme" Click="OnMenuSwitchTheme" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Keyboard Shortcuts" Gesture="Cmd+OemQuestion" Click="OnMenuShowShortcuts" />
            <NativeMenuItemSeparator />
            <!--
              Density radio group: the toolbar's DensityBox ComboBox is the primary control (see
              its own comment), this is the "and/or a View menu entry" half. ToggleType="Radio" +
              IsChecked below are only the Default-tier starting state matching
              DisplayDensity.Current's own default; OnDensityBoxLoaded/OnDensityMenuClick
              (MainWindow.axaml.cs) keep the real state in sync from there. Deliberately unnamed:
              NativeMenuItem does not support x:Name/Name in this Avalonia build (verified against
              the actual package - it throws "Unable to resolve suitable regular or attached
              property Name" at parse time, since NativeMenuItem is an AvaloniaObject rather than
              a StyledElement and has no naming/NameScope registration path), so code-behind finds
              these three by walking NativeMenu.GetMenu(this)'s Items and matching on Header text
              instead of FindControl (also unusable here - it is constrained to T : Control, which
              NativeMenuItem is not).
            -->
            <NativeMenuItem Header="Density: Compact" ToggleType="Radio" Click="OnDensityMenuClick" />
            <NativeMenuItem Header="Density: Default" ToggleType="Radio" IsChecked="True" Click="OnDensityMenuClick" />
            <NativeMenuItem Header="Density: Comfortable" ToggleType="Radio" Click="OnDensityMenuClick" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <!--
    Focus visibility: Avalonia/FluentTheme's default keyboard-focus indication is easy to miss at
    this shell's font sizes (the brief calls it out explicitly - "make focus obvious without
    making it ugly"). ListBoxItem/TreeViewItem's Fluent ControlThemes already TemplateBind
    BorderBrush/BorderThickness straight from the item (see MetroStyles.axaml's own
    "ListBox#FieldList ListBoxItem:selected" rule, which sets those same two properties directly
    on the item to draw the selected-row accent bar) - so the same mechanism, keyed off
    :focus-visible (keyboard focus only; a pointer click that focuses a row doesn't also ring it,
    which would be noisy since :selected already marks it) rather than :focus (which also fires
    for pointer-acquired focus), reuses a path already proven to render rather than guessing at
    template part names for a control this pass doesn't otherwise touch. Buttons/TextBoxes/
    ComboBoxes already get a reasonable default ring from FluentTheme and are left alone.
  -->
  <Window.Styles>
    <Style Selector="TreeViewItem:focus-visible">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource ExtryzeAccentBrushSecondary}" />
    </Style>
    <Style Selector="ListBox#FieldList ListBoxItem:focus-visible">
      <Setter Property="BorderThickness" Value="2,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ExtryzeAccentBrushSecondary}" />
    </Style>
    <Style Selector="ListBoxItem:focus-visible /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    </Style>
    <Style Selector="Button:focus-visible /template/ Border#PART_Border, ToggleButton:focus-visible /template/ Border#PART_Border">
      <Setter Property="BorderBrush" Value="{DynamicResource ExtryzeAccentBrushSecondary}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </Window.Styles>

  <!--
    ================= overlay host =================
    Wraps the existing content Grid in a Panel so the command palette and shortcuts cheatsheet can
    stack on top of everything else (including the console/status bar) as the last two children -
    Panel/Grid render children in declaration order, so "declared last" is "drawn on top". Both
    start IsVisible="False"/IsHitTestVisible="False" (see their own control headers) and are
    toggled from code-behind by OnGlobalKeyDown / the command registry, not bound to a view-model
    property - see this file's own remarks up top on why NativeMenu gestures and the in-window
    global handler are necessarily two separate things.
  -->
  <Panel>
  <Grid Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="60" />
      <RowDefinition Height="34" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="170" />
      <RowDefinition Height="22" />
    </Grid.RowDefinitions>

    <!-- ================= header band (Home.xaml's homeHeader, 60px) ================= -->
    <Border Grid.Row="0" Background="{DynamicResource SidebarHeaderBrush}"
            BorderBrush="{DynamicResource ExtryzeAccentBrush}" BorderThickness="0,0,0,2">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource Space3}" VerticalAlignment="Center">
          <!-- exact AsmLogo path data ported from src/Assembly/App.xaml -->
          <Path Width="26" Height="26" Stretch="Uniform" Fill="{DynamicResource ExtryzeAccentBrush}"
                Data="M1122.8,589.7c0,0-32.2,6.1-46.3-37.3c-14.1-43.4-80.5-145.9-328.8-203c-248.3-57.1-467.7,0-467.7,0
                l-29.9,32.8c0,0-172.6,32.3-242.1,141.8l40.3,29.9c0,0,54.9-112.1,319.8-138.8c52.4-5.3,100.4-8,144.5-8.2l-54.8,61.3l-7.5-4.5
                l-54.9,61.2h53.4l25.4-26.9l77.7,85.1H384.6l-19.4,28.4h-47.4L179.8,765.2H135v34.3h119.5v21.6c0,0,51.4,13.9,161.4,28.4
                l35.9,25.4c0,0,258.6,4.5,415.4-50.8c156.8-55.3,206.8-158.7,215.2-171.7c8.4-13,14.2-27.9,37.4-25.4h73.2v-37.3H1122.8z
                M679,765.2v20.4c-95.3,21.3-226.4,29.2-399.7-3l0.7-1h133v-17.9h-89.7l107.6-126.9h173.3l112.1,128.4H679z M886.7,689.8
                c-3,2.5-20.8,19.4-56.1,39.4L528.9,406.9c169.7,1.4,279.6,40.2,356.3,106.7C983.8,599.2,896.7,681.3,886.7,689.8z" />
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="ASSEMBLY" FontFamily="{StaticResource MetroFontLight}"
                       FontSize="{StaticResource FontSizeDisplay}" LetterSpacing="2" />
            <!--
              HeaderSubtitle (Converters.cs) trims WindowTitle's own trailing " - Assembly" - that
              suffix belongs on the native window title bar just above this band (where repeating
              the app name is normal), not on a second line 20px under a wordmark that already
              says "ASSEMBLY". Two readings of the same word in one glance was one of the concrete
              defects called out for this pass - see that converter's remarks for the full case.
            -->
            <TextBlock Text="{Binding WindowTitle, Converter={StaticResource HeaderSubtitle}}" Classes="label mono"
                       FontSize="{StaticResource FontSizeMicro}" MaxWidth="520" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource Space3}" VerticalAlignment="Center">
          <TextBlock Text="{Binding EngineStatus}" Classes="mono" FontSize="{StaticResource FontSizeSmall}"
                     Foreground="{Binding EngineStatusOk, Converter={StaticResource OkBrush}}" />
          <Border Width="1" Height="14" Background="{DynamicResource SidebarHeaderSeperatorBrush}" />
          <TextBlock Text="{Binding RuntimeStatus}" Classes="mono dim" FontSize="{StaticResource FontSizeSmall}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= toolbar ================= -->
    <Border Grid.Row="1" Background="{DynamicResource SidebarBackgroundBrush}"
            BorderBrush="{DynamicResource SidebarHeaderSeperatorBrush}" BorderThickness="0,0,0,1">
      <!--
        Column order groups by purpose: file operations left, view controls right, spacer between.
        Two agents independently appended to this toolbar and both numbered from 10, so the
        indices below were reassigned by hand at merge - if you add a control, renumber rather
        than appending past the end.
      -->
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="8,0">
        <Button Grid.Column="0" Content="Open File..." Click="OnOpenFileClick" Margin="2" />
        <Button Grid.Column="1" Content="Open Folder..." Click="OnOpenFolderClick" Margin="2" />
        <Button Grid.Column="2" Content="Open Zip..." Click="OnOpenZipClick" Margin="2" />
        <Border Grid.Column="3" Width="1" Margin="6,6" Background="{DynamicResource SidebarHeaderSeperatorBrush}" />
        <Button Grid.Column="4" Content="Save" Classes="accent" Click="OnSaveClick" Margin="2"
                IsEnabled="{Binding ActiveDocument.IsDirty, FallbackValue=False, TargetNullValue=False}" />
        <Border Grid.Column="5" Width="1" Margin="6,6" Background="{DynamicResource SidebarHeaderSeperatorBrush}" />
        <Button Grid.Column="6" Content="Unpack..." Click="OnUnpackClick" Margin="2"
                ToolTip.Tip="Extract a Campaign Evolved container set's tags to a folder" />
        <Button Grid.Column="7" Content="Repack..." Click="OnRepackClick" Margin="2"
                ToolTip.Tip="Build a Campaign Evolved container set from a folder of tags" />

        <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="{DynamicResource Space1}" IsVisible="{Binding HasAnySource}"
                    VerticalAlignment="Center" Margin="0,0,10,0">
          <TextBlock Text="{Binding Sources.Count, StringFormat='{}{0} source(s)'}" Classes="label" VerticalAlignment="Center" />
        </StackPanel>

        <!--
          Display density: Compact/Default/Comfortable (Services/DisplayDensity.cs), driving row
          height in the field table and tag tree, control height, and the type/spacing scale -
          see that file's header for exactly what does and doesn't reflow. Not bound to
          MainViewModel (density is a standalone, non-tag-session concern, and ViewModels/ is
          another pass's this wave) - OnDensityBoxLoaded/OnDensityChanged (MainWindow.axaml.cs)
          read and write Services/AppSettings.cs's Density property directly, and
          DisplayDensity.Changed keeps this box in sync if density is ever changed from elsewhere
          (the View menu's radio items below, or a future command-palette entry - see
          AppSettings.Density's own remarks for the public API a palette command should call).
        -->
        <ComboBox Grid.Column="10" Name="DensityBox" Width="122" Margin="0,0,6,0"
                  Loaded="OnDensityBoxLoaded" SelectionChanged="OnDensityChanged"
                  ToolTip.Tip="Display density - row height, spacing and control size in the field table and tag tree">
          <ComboBoxItem Content="Compact" Tag="Compact" />
          <ComboBoxItem Content="Default" Tag="Default" />
          <ComboBoxItem Content="Comfortable" Tag="Comfortable" />
        </ComboBox>
        <Border Grid.Column="11" Width="1" Margin="6,6" Background="{DynamicResource SidebarHeaderSeperatorBrush}" />

        <!-- Chrome toggles: hand-drawn vector pictograms (Theme/Icons.axaml) replacing the old
             "&#9776;" / "&#9635;" / "&gt;_" Unicode-glyph Content - see the brief's icon
             requirement. Each icon's shape mirrors what it does (a panel filled on the side it
             docks to; a terminal frame with a prompt) rather than being an arbitrary symbol.

             Fill/Stroke are deliberately NOT set here any more (they were local literals -
             Fill="Transparent" Stroke="{DynamicResource VectorBrush}" - which, being local values,
             could never be overridden by MetroStyles.axaml's ToggleButton.chrome:checked Path
             Style Setter; see Services/DisplayDensity.cs's header for why a Style Setter can never
             win against a local value in Avalonia). Classes="chromeIcon" moves both into that
             file's own Style selectors instead, which is what actually lets the checked/hover
             states change the icon's colour - see MetroStyles.axaml's "Icon-only chrome toggle"
             section. -->
        <ToggleButton Grid.Column="12" Classes="chrome" IsChecked="{Binding ShowTagTree}"
                      ToolTip.Tip="Toggle tag tree (sidebar)" Margin="2">
          <Path Classes="chromeIcon" Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconSidebarLeft}"
                StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" />
        </ToggleButton>
        <ToggleButton Grid.Column="13" Classes="chrome" IsChecked="{Binding ShowValueSidebar}"
                      ToolTip.Tip="Toggle properties sidebar" Margin="2">
          <Path Classes="chromeIcon" Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconSidebarRight}"
                StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" />
        </ToggleButton>
        <ToggleButton Grid.Column="14" Classes="chrome" IsChecked="{Binding ShowConsole}"
                      ToolTip.Tip="Toggle console" Margin="2">
          <Path Classes="chromeIcon" Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconConsole}"
                StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" />
        </ToggleButton>
      </Grid>
    </Border>

    <!-- ================= body: tag tree | documents | value sidebar ================= -->
    <Grid Grid.Row="2" Name="BodyGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="320" />
      </Grid.ColumnDefinitions>

      <!-- == tag tree sidebar == -->
      <Border Grid.Column="0" Name="TagTreePane" Background="{DynamicResource SidebarBackgroundBrush}"
              IsVisible="{Binding ShowTagTree}">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <Border Grid.Row="0" Background="{DynamicResource SidebarHeaderBrush}"
                  BorderBrush="{DynamicResource SidebarHeaderSeperatorBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="TAG NAMESPACE" Classes="sectionHeader" Margin="12,8" />
          </Border>

          <!-- mounted sources: a "cache" is a mount of N containers, not one file -->
          <Border Grid.Row="1" IsVisible="{Binding HasAnySource}"
                  BorderBrush="{DynamicResource SidebarHeaderSeperatorBrush}" BorderThickness="0,0,0,1">
            <ItemsControl ItemsSource="{Binding Sources}" Margin="8,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                    <Border Grid.Column="0" Background="{DynamicResource SidebarBlockBrush}" Padding="4,1" Margin="0,0,6,0">
                      <TextBlock Text="{Binding Kind}" FontSize="9" Classes="mono" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Classes="mono" FontSize="{StaticResource FontSizeSmall}"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                    <TextBlock Grid.Column="2" Text="{Binding SummaryLabel}" Classes="label" FontSize="{StaticResource FontSizeMicro}" Margin="6,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="8">
            <TextBox Grid.Column="0" Name="SearchBox" PlaceholderText="Filter tags..."
                     Text="{Binding Search, Mode=TwoWay}" />
            <ComboBox Grid.Column="1" Margin="6,0,0,0" Width="110"
                      ItemsSource="{Binding TreeModes}"
                      SelectedItem="{Binding TreeMode, Mode=TwoWay}"
                      ToolTip.Tip="Group tags by their 4-char tag group, or by tag-name folder path" />
          </Grid>

          <TreeView Grid.Row="3" Name="TagTree" Margin="2,0,2,4"
                    ItemsSource="{Binding Nodes}"
                    SelectionChanged="OnTreeSelectionChanged">
            <!--
              Avalonia's ItemsControl defaults to a plain StackPanel (realizes every item, no
              matter how many); ListBox overrides that default to VirtualizingStackPanel in its
              static constructor, but TreeView and TreeViewItem do not - each level of the tree
              would realize its full child list the moment its parent is expanded otherwise.
              A tag group or folder can hold thousands of tags (a retail mount's tag tree runs to
              ~12,000 entries total), so both the root level (ItemsPanel below) and every expanded
              node's own child level (the TreeViewItem style's ItemsPanel setter) need this.
            -->
            <TreeView.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </TreeView.ItemsPanel>
            <TreeView.Styles>
              <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, FallbackValue=False}" />
                <Setter Property="ItemsPanel">
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </Setter>
              </Style>
            </TreeView.Styles>
            <TreeView.DataTemplates>
              <TreeDataTemplate DataType="vm:GroupNode" ItemsSource="{Binding Tags}">
                <Grid ColumnDefinitions="Auto,*,Auto" Classes="treeGroupRow">
                  <TextBlock Grid.Column="0" Text="{Binding Magic}" Classes="mono"
                             Foreground="{StaticResource ExtryzeAccentBrushSecondary}" Width="38" FontSize="{DynamicResource FontSizeSmall}" />
                  <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="{DynamicResource FontSizeSmall}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding CountLabel}" Classes="label"
                             Margin="8,0,4,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeMicro}" />
                </Grid>
              </TreeDataTemplate>
              <TreeDataTemplate DataType="vm:FolderNode" ItemsSource="{Binding Children}">
                <Grid ColumnDefinitions="*,Auto" Classes="treeGroupRow">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="{DynamicResource FontSizeSmall}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding CountLabel}" Classes="label"
                             Margin="8,0,4,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeMicro}" />
                </Grid>
              </TreeDataTemplate>

              <DataTemplate DataType="vm:TagNode">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="{DynamicResource FontSizeSmall}"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OffsetLabel}" />
                  <TextBlock Grid.Column="1" Text="{Binding SourceName}" Classes="label" FontSize="9"
                             IsVisible="{Binding $parent[TreeView].DataContext.HasMultipleSources}"
                             Margin="4,0,4,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Group}" Classes="mono" FontSize="{DynamicResource FontSizeMicro}"
                             Foreground="{StaticResource TextBrushSecondary}"
                             Margin="4,0,4,0" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </TreeView.DataTemplates>
          </TreeView>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource SidebarHeaderSeperatorBrush}"
                    ResizeDirection="Columns" IsVisible="{Binding ShowTagTree}" />

      <!-- == document area: tab strip + field table == -->
      <Grid Grid.Column="2" RowDefinitions="30,*" Background="{DynamicResource MainBackgroundBrush}">

        <!--
          Tab strip - VS/VS Code ergonomics: the active tab owns the content below it (matching
          background + a heavier accent underline, set by RefreshTabStyles in code-behind), a
          dirty dot that swaps for the close glyph on hover (pure :pointerover Style selectors in
          MetroStyles.axaml - see "tabDirtyDot"/"tabClose" there), and middle-click-to-close
          (OnTabPointerPressed below; Button.Click only fires for the primary button, hence the
          extra handler). PointerWheelChanged on the ScrollViewer redirects vertical wheel/
          trackpad delta to horizontal scroll, since a horizontal strip of many tabs is otherwise
          unreachable by wheel at all on most pointing devices - see OnTabStripWheel.
        -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarHeaderBrush}"
                BorderBrush="{DynamicResource SidebarHeaderSeperatorBrush}" BorderThickness="0,0,0,1">
          <ScrollViewer Name="TabScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                        PointerWheelChanged="OnTabStripWheel">
            <ItemsControl ItemsSource="{Binding Documents}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- "active" class toggled in code-behind (RefreshTabStyles) whenever ActiveDocument changes -->
                  <Button Classes="tabHeader" Click="OnTabClick" PointerPressed="OnTabPointerPressed" Tag="{Binding}"
                          ToolTip.Tip="{Binding HeaderTitle}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                      <TextBlock Text="{Binding TabTitle, Converter={StaticResource StripDirtyMarker}}"
                                 Classes="tabTitle" VerticalAlignment="Center" />
                      <Ellipse Classes="tabDirtyDot" Width="6" Height="6" IsVisible="{Binding IsDirty}"
                               Fill="{DynamicResource DirtyStateBrush}" ToolTip.Tip="Unsaved changes" />
                      <Button Classes="tabClose" Click="OnTabCloseClick" Tag="{Binding}" ToolTip.Tip="Close (middle-click also works)">
                        <Path Width="8" Height="8" Stretch="Uniform" Data="{StaticResource IconClose}"
                              Fill="Transparent" Stroke="{DynamicResource TextBrushSecondary}" StrokeThickness="1.7"
                              StrokeLineCap="Round" Classes="tabCloseIcon" />
                      </Button>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <!--
          Empty state. "No tag open" alone gave a reader nothing to act on - now it's two states:
          no source mounted at all (big CTAs mirroring the toolbar's Open actions, with their
          keyboard shortcuts spelled out, since a first-run user has no reason to know them yet)
          vs a source mounted but nothing selected (a reminder of what's already mounted - the
          nearest thing this app has to "recent sources", see MainViewModel.Sources - plus the
          search shortcut). MessageIsError/HasMessage (MainViewModel) surface a mount failure
          inline instead of just silently staying on the CTA screen.
        -->
        <Grid Grid.Row="1" IsVisible="{Binding !HasDocuments}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{StaticResource Space3}" MaxWidth="480">
            <TextBlock Text="No tag open" Classes="h1" HorizontalAlignment="Center" />

            <StackPanel IsVisible="{Binding !HasAnySource}" Spacing="{StaticResource Space3}">
              <TextBlock Text="Mount a cache, a folder of cache files, or a Campaign Evolved container set to get started."
                         Classes="label" TextWrapping="Wrap" TextAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" HorizontalAlignment="Center">
                <Button Click="OnOpenFileClick" Padding="14,6">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                    <Path Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconFile}"
                          Fill="Transparent" Stroke="{DynamicResource ButtonForegroundBrush}" StrokeThickness="1.5"
                          StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
                    <TextBlock Text="Open Cache File..." VerticalAlignment="Center" />
                    <TextBlock Text="⌘O" Classes="label mono dim" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Click="OnOpenFolderClick" Padding="14,6">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                    <Path Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconFolder}"
                          Fill="{DynamicResource ButtonForegroundBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Open Folder..." VerticalAlignment="Center" />
                    <TextBlock Text="⇧⌘O" Classes="label mono dim" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <!--
                Two TextBlocks, not one Foreground-swapping binding: MessageIsError=false is the
                default "nothing has happened yet" state (see MainViewModel's constructor, which
                sets it alongside the neutral "Nothing mounted" guidance text below), not a
                success confirmation - colouring it via OkBrushConverter's true/false pair would
                paint that neutral first-run guidance green, which reads as "it worked" before
                the user has done anything. Only an actual mount failure gets a colour. Both are
                also gated on the outer StackPanel's IsVisible="{Binding !HasAnySource}" (this is
                the "no source mounted" branch), under which HasMessage is always true anyway
                (MainViewModel sets HasMessage = !HasAnySource) - so MessageIsError alone is
                enough to pick between them.
              -->
              <TextBlock Text="{Binding Message}" Classes="label" TextWrapping="Wrap" TextAlignment="Center"
                         IsVisible="{Binding !MessageIsError}" />
              <TextBlock Text="{Binding Message}" Classes="label" TextWrapping="Wrap" TextAlignment="Center"
                         Foreground="{DynamicResource ErrorBrush}" FontFamily="{DynamicResource MetroFontSemiBold}"
                         IsVisible="{Binding MessageIsError}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding HasAnySource}" Spacing="{StaticResource Space2}">
              <TextBlock Text="A namespace is mounted - select a tag in the tree to open it."
                         Classes="label" TextWrapping="Wrap" TextAlignment="Center" />
              <TextBlock Text="{Binding Sources.Count, StringFormat='{}{0} mounted source(s) - press ⌘F to filter the tree'}"
                         Classes="label mono dim" TextWrapping="Wrap" TextAlignment="Center" FontSize="{StaticResource FontSizeMicro}" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- field table -->
        <Grid Grid.Row="1" IsVisible="{Binding HasDocuments}" RowDefinitions="Auto,Auto,Auto,*">
          <Border Grid.Row="0" Padding="14,8" BorderBrush="{StaticResource SidebarHeaderSeperatorBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="1">
                <SelectableTextBlock Text="{Binding ActiveDocument.HeaderTitle}" Classes="mono accent" FontSize="{DynamicResource FontSizeMedium}" />
                <TextBlock Text="{Binding ActiveDocument.SchemaStatus}" Classes="label" FontSize="{DynamicResource FontSizeMicro}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="Revert All" Click="OnRevertAllClick" IsEnabled="{Binding ActiveDocument.IsDirty, FallbackValue=False, TargetNullValue=False}" />
                <Button Content="Save" Classes="accent" Click="OnSaveClick" IsEnabled="{Binding ActiveDocument.IsDirty, FallbackValue=False, TargetNullValue=False}" />
              </StackPanel>
            </Grid>
          </Border>

          <!--
            In-tag field filter: matches a row's name, its TYPE column text, or its formatted
            value, and (see TagDocumentViewModel's "field search / filter" remarks) searches
            unexpanded blocks too - on a 1806-field scenario tag almost everything is unexpanded
            at any given time, so a filter limited to what's on screen would rarely find anything.
          -->
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="6,4">
            <TextBox Grid.Column="0" Name="FieldFilterBox" PlaceholderText="Filter fields by name, type or value..."
                      Text="{Binding ActiveDocument.FilterQuery, Mode=TwoWay}"
                      KeyDown="OnFieldFilterKeyDown" />
            <TextBlock Grid.Column="1" Classes="label" FontSize="{DynamicResource FontSizeMicro}" VerticalAlignment="Center" Margin="8,0,4,0"
                       IsVisible="{Binding ActiveDocument.IsFiltering, FallbackValue=False}"
                       Text="{Binding ActiveDocument.FilterMatchCount, StringFormat='{}{0} match(es)'}" />
          </Grid>

          <Grid Grid.Row="2" ColumnDefinitions="26,90,120,*" Margin="6,4">
            <TextBlock Grid.Column="1" Text="OFFSET" Classes="sectionHeader" />
            <TextBlock Grid.Column="2" Text="TYPE" Classes="sectionHeader" />
            <TextBlock Grid.Column="3" Text="FIELD / VALUE" Classes="sectionHeader" />
          </Grid>

          <!--
            The ListBox is left at Avalonia's default ItemsPanel (ListBox overrides ItemsControl's
            own default to VirtualizingStackPanel in its static constructor - see TagTree's remarks
            on the equivalent TreeView gap), which is what makes a fully-expanded scenario tag's row
            count (hundreds to low thousands) cheap to display: only the rows actually on screen,
            plus a small buffer, are ever realized as real controls.
          -->
          <Grid Grid.Row="3">
            <ListBox Name="FieldList" ItemsSource="{Binding ActiveDocument.Rows}"
                      SelectedItem="{Binding ActiveDocument.SelectedRow, Mode=TwoWay}"
                      SelectionChanged="OnRowSelectionChanged"
                      DoubleTapped="OnFieldListDoubleTapped"
                      KeyDown="OnFieldListKeyDown"
                      Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:MetaRowViewModel">
                  <Grid ColumnDefinitions="4,26,90,120,*">
                    <!-- dirty-state accent strip: real per-row indicator, not just the tab title asterisk -->
                    <Rectangle Grid.Column="0" Width="3" HorizontalAlignment="Left"
                               Fill="{Binding IsDirty, Converter={StaticResource DirtyBrush}}" />
                    <ToggleButton Grid.Column="1" Classes="blockExpander" IsChecked="{Binding IsExpanded, Mode=OneWay}"
                                  IsVisible="{Binding IsBlock}" Click="OnBlockExpandClick" Tag="{Binding}">
                      <Path Width="7" Height="7" Stretch="Uniform" Fill="{StaticResource TextBrushSecondary}"
                            Data="{Binding IsExpanded, Converter={StaticResource ExpanderGlyph}}" />
                    </ToggleButton>
                    <TextBlock Grid.Column="2" Text="{Binding OffsetLabel}" Classes="mono" FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{StaticResource TextBrushSecondary}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding KindLabel}" Classes="label" VerticalAlignment="Center" />
                    <Grid Grid.Column="4" ColumnDefinitions="Auto,*,Auto,Auto">
                      <!--
                        Indent guides: one 16px-wide slot per ancestor level (DepthRangeConverter,
                        Converters.cs), each holding a single vertical hairline, real elements
                        rather than a container-level Background trick - see that converter's
                        remarks for why the previous DrawingBrush approach never actually rendered
                        (this pass found it invisible at every zoom level once a real block was
                        expanded, not merely "artifact"-looking as first suspected). Placed ahead
                        of the Name text in the same row rather than as a Margin on it, so the
                        guides are visible siblings instead of dead space - what used to be
                        DepthIndentConverter's job (widening a Margin) is now just "however wide
                        this ItemsControl's own realized items are", so no separate indent
                        calculation is needed any more.
                      -->
                      <ItemsControl Grid.Column="0" ItemsSource="{Binding Depth, Converter={StaticResource DepthRange}}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Width="16" VerticalAlignment="Stretch">
                              <Rectangle Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                         Fill="{DynamicResource FieldRowDividerBrush}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Grid.Column="1" Text="{Binding Name}"
                                 FontFamily="{StaticResource MetroFontRegular}" FontSize="{DynamicResource FontSizeSmall}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding Def.Tooltip}" />
                      <TextBlock Grid.Column="2" Text="{Binding DisplayValue}" Classes="mono accent" FontSize="{DynamicResource FontSizeSmall}"
                                 VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="380" TextTrimming="CharacterEllipsis" />
                      <!--
                        Tag-reference navigation: a classic TagReference field resolves through the
                        owning cache (TagDocumentViewModel.TryResolveClassicTagRef); a fifth-generation
                        one carries its target path/group directly (FifthGenTagReferenceValue). Either
                        way RefTarget is non-null only when there is something to follow - double-click
                        or Enter on the row do the same thing this button does.
                      -->
                      <Button Grid.Column="3" Content="open &#8594;" FontSize="9.5" Padding="5,1" Margin="8,0,0,0"
                              VerticalAlignment="Center" IsVisible="{Binding IsReference}"
                              Click="OnFollowReferenceClick" Tag="{Binding}"
                              ToolTip.Tip="Open the referenced tag in a new tab" />
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- loading state: TagDocumentViewModel's constructor (and, for a Campaign Evolved
                 tag, the ~400ms FifthGenTagFile parse inside it) now runs off the UI thread - see
                 MainViewModel.OpenTagAsync - so the shell stays responsive while it runs, and this
                 is what tells the user something is actually happening instead of nothing. -->
            <Border IsVisible="{Binding IsOpeningTag}" Background="#D01e1e20">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Classes="label" FontSize="{DynamicResource FontSizeBase}" HorizontalAlignment="Center"
                           Text="{Binding OpeningTagLabel, StringFormat='Opening {0}...'}" />
                <TextBlock Classes="label dim" FontSize="{DynamicResource FontSizeMicro}" HorizontalAlignment="Center"
                           Text="Parsing runs off the UI thread; the window stays responsive." />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <GridSplitter Grid.Column="3" Width="1" Background="{DynamicResource SidebarHeaderSeperatorBrush}"
                    ResizeDirection="Columns" IsVisible="{Binding ShowValueSidebar}" />

      <!-- == value / properties sidebar == -->
      <Border Grid.Column="4" Background="{DynamicResource SidebarBackgroundBrush}"
              IsVisible="{Binding ShowValueSidebar}">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Background="{DynamicResource SidebarHeaderBrush}"
                  BorderBrush="{DynamicResource SidebarHeaderSeperatorBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="PROPERTIES" Classes="sectionHeader" Margin="12,8" />
          </Border>
          <!-- EditorHost's own children are owned by the properties-panel pass (see its header
               comment in MainWindow.axaml.cs); this ScrollViewer/StackPanel shell around it is
               chrome and is this pass's to style. -->
          <ScrollViewer Grid.Row="1">
            <views:PropertiesPanel Name="PropertiesPanelControl" Margin="14,12"
                                    Document="{Binding ActiveDocument}" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- ================= console splitter + console ================= -->
    <GridSplitter Grid.Row="3" Height="1" Background="{DynamicResource SidebarHeaderSeperatorBrush}"
                  ResizeDirection="Rows" IsVisible="{Binding ShowConsole}" />

    <!--
      Console: level-coloured badge chips (not just tinted text - see ".consoleLevel*" classes in
      MetroStyles.axaml), a text filter, a min-level filter, copy-visible-to-clipboard, and actual
      auto-scroll-to-tail. The old version never scrolled at all - Log.Entries had no listener
      anywhere - so new output silently accumulated below the fold unless you happened to already
      be scrolled to the bottom and dragged the splitter. ConsoleList's ItemsSource is populated
      and kept in sync from code-behind (see RefreshConsoleFilter in MainWindow.axaml.cs) rather
      than bound directly to Log.Entries, since the filter needs to see every append to decide
      whether to scroll - LogService (ViewModels/) isn't a file this pass owns, so filtering has
      to live on this side of the binding rather than as a live CollectionView on that one.
    -->
    <Border Grid.Row="4" Background="{DynamicResource InputBackgroundBrush}" IsVisible="{Binding ShowConsole}" Height="170">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource SidebarHeaderBrush}"
                BorderBrush="{DynamicResource SidebarHeaderSeperatorBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="0,4">
            <TextBlock Grid.Column="0" Text="CONSOLE" Classes="sectionHeader" Margin="12,0" VerticalAlignment="Center" />
            <Path Grid.Column="1" Width="11" Height="11" Stretch="Uniform" Data="{StaticResource IconFilter}"
                  Fill="{DynamicResource TextBrushSecondary}" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Grid.Column="2" Name="ConsoleFilterBox" PlaceholderText="Filter console output..."
                      TextChanged="OnConsoleFilterChanged" MinHeight="20" Margin="0,0,6,0" VerticalAlignment="Center" />
            <ComboBox Grid.Column="3" Name="ConsoleLevelBox" Width="96" MinHeight="20" Margin="0,0,6,0"
                      SelectedIndex="0" SelectionChanged="OnConsoleFilterChanged" VerticalAlignment="Center"
                      ToolTip.Tip="Minimum level to show">
              <ComboBoxItem>All levels</ComboBoxItem>
              <ComboBoxItem>Warn+</ComboBoxItem>
              <ComboBoxItem>Errors</ComboBoxItem>
            </ComboBox>
            <Button Grid.Column="4" Classes="chrome" Click="OnConsoleCopyClick" ToolTip.Tip="Copy visible lines" Margin="2">
              <Path Classes="chromeIcon" Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconCopy}"
                    StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" />
            </Button>
            <Button Grid.Column="5" Content="Clear" Click="OnConsoleClearClick" Margin="4,0,10,0" />
          </Grid>
        </Border>
        <ListBox Grid.Row="1" Name="ConsoleList"
                  Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:LogEntry">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                <TextBlock Text="{Binding TimeLabel}" Classes="mono dim" FontSize="{StaticResource FontSizeMicro}" Width="56" VerticalAlignment="Center" />
                <TextBlock Text="{Binding LevelLabel}" Classes="mono consoleLevel" FontSize="{StaticResource FontSizeMicro}" Width="40"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}"
                           Background="{Binding Level, Converter={StaticResource LogLevelBackgroundBrush}}" />
                <TextBlock Text="{Binding Message}" Classes="mono" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!--
      ================= status bar =================
      Quiet chrome normally, the shared dirty gold only when there is actually something to
      report - see FooterBrushConverter/FooterForegroundBrushConverter (Converters.cs) for why:
      a status bar filled with the solid accent blue at all times was "a coloured strip bolted
      on" (one of the concrete defects called out for this pass) rather than chrome the accent
      could ever stand out against, since a reader has already seen that exact blue on the
      header's top edge, the active tab underline and every accent button by the time they reach
      the bottom of the window. The top hairline is new too, for the same reason every other
      panel header in this shell (tag namespace, properties, console) gets one against the
      surface above it - this bar wasn't previously chrome so much as a colour swatch.
    -->
    <Border Grid.Row="5" Background="{Binding ActiveDocument.IsDirty, Converter={StaticResource FooterBrush}}"
            BorderBrush="{DynamicResource SidebarHeaderSeperatorBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusText}" Classes="mono" FontSize="{StaticResource FontSizeSmall}"
                   VerticalAlignment="Center" Margin="12,0"
                   Foreground="{Binding ActiveDocument.IsDirty, Converter={StaticResource FooterForegroundBrush}}" />
        <!-- Colour alone (the footer's gold dirty tint) isn't a safe-enough signal on its own -
             this spells "unsaved" out as text too. -->
        <TextBlock Grid.Column="1" Text="● unsaved changes" Classes="mono" FontSize="{StaticResource FontSizeSmall}"
                   VerticalAlignment="Center" Foreground="White" Margin="0,0,14,0"
                   IsVisible="{Binding ActiveDocument.IsDirty, FallbackValue=False, TargetNullValue=False}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="0,0,12,0">
          <TextBlock Text="{Binding ActiveDocument.SelectedRow.OffsetLabel}" Classes="mono" FontSize="{StaticResource FontSizeSmall}"
                     Foreground="{Binding ActiveDocument.IsDirty, Converter={StaticResource FooterForegroundBrush}}"
                     IsVisible="{Binding ActiveDocument.SelectedRow, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>

  <views:CommandPalette x:Name="Palette" />
  <views:ShortcutsOverlay x:Name="Shortcuts" />
  </Panel>
</Window>
