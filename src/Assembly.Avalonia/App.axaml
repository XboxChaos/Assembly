<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Assembly.Avalonia.Views"
             x:Class="Assembly.Avalonia.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AssemblyAvalonia/Theme/MetroStyles.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AssemblyAvalonia/Theme/MetroDark.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <views:OkBrushConverter x:Key="OkBrush" />
      <views:FooterBrushConverter x:Key="FooterBrush" />
    </ResourceDictionary>
  </Application.Resources>

</Application>
