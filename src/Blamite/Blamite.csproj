<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <OutputType>Library</OutputType>
    <RootNamespace>Blamite</RootNamespace>
    <AssemblyName>Blamite</AssemblyName>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <LangVersion>8.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Properties\AssemblyInfo.cs is checked in and still owns the assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- The dead DNX-era project.json is still sitting in this folder; be explicit so NuGet
         never mistakes it for a project.json-style restore. -->
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <!-- Preserve the symbols the old non-SDK project defined for every configuration it
         actually shipped (Debug/Release, AnyCPU and x64). X86 is dropped along with the
         x86 configurations, which the solution never mapped to. -->
    <DefineConstants>$(DefineConstants);EXPORT_GPPG;NET45;X64</DefineConstants>
    <!-- The vendored 7-Zip SDK and a lot of the old Blam code trip these; they were never
         errors under the old project either. -->
    <NoWarn>$(NoWarn);CS0169;CS0414;CS0649</NoWarn>
    <!-- NU1510 claims System.Text.Encoding.CodePages is redundant. It is not: .NET 10 still has
         no in-box Windows-1252, which Read/WriteWin1252 depend on. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.8.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Drawing" />
    <Reference Include="System.Data.DataSetExtensions" />
    <!-- Lets the net48 target framework compile on machines without the .NET Framework
         targeting packs installed (i.e. macOS/Linux via `dotnet build`). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- System.CodeDom  -> IndentedTextWriter, used by BlamScriptGenerator.
         System.Drawing.Common -> Bitmap etc., used by RTE\Console\Native\Screenshot.cs.
         System.Text.Encoding.CodePages -> Windows-1252, which .NET Core does not ship in-box. -->
    <PackageReference Include="System.CodeDom" Version="9.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Formats\**" />
    <Content Include="Formats\**\*.xml;Formats\**\*.csv">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
